# Database (Supabase Cloud)
# Use the direct Postgres connection string from your Supabase project.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_USER=safo
DB_PASSWORD=safo_password
DB_NAME=safo_db

# Redis is disabled temporarily for local development.
# REDIS_HOST=localhost
# REDIS_PORT=6379

# JWT
JWT_SECRET=safo_super_secret_key_change_in_prod
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=safo_super_refresh_secret
JWT_REFRESH_EXPIRATION=7d

# Payment (Midtrans)
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxx

# App
PORT=3000
NODE_ENV=development
