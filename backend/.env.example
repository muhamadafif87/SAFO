# Database (Supabase Cloud)
#
# PAKAI SESSION POOLER, bukan koneksi direct.
#   - Direct (db.<ref>.supabase.co:5432) di banyak jaringan hanya punya
#     record IPv6, sehingga Node gagal "connect ENETUNREACH".
#   - Pooler (aws-0-<region>.pooler.supabase.com:5432) punya IPv4 dan
#     mode session-nya mendukung prepared statement, jadi aman untuk
#     TypeORM termasuk menjalankan migrasi (DDL).
#   - Username pooler diawali "postgres.<project-ref>", bukan "postgres".
#
# PENTING: JANGAN tambahkan ?sslmode=require di sini.
#   data-source.ts sudah set ssl.rejectUnauthorized=false. Bila sslmode
#   ditulis di URL, pg akan menimpa opsi tersebut dan koneksi gagal dengan
#   "self-signed certificate in certificate chain".
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=safo_password
DB_NAME=postgres

# Redis is disabled temporarily for local development.
# REDIS_HOST=localhost
# REDIS_PORT=6379

# JWT
JWT_SECRET=safo_super_secret_key_change_in_prod
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=safo_super_refresh_secret
JWT_REFRESH_EXPIRATION=7d

# Payment (Midtrans)
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxx

# Supabase S3 Storage
SUPABASE_S3_ENDPOINT=https://cyakqxtjwyettzyzysok.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-southeast-1
SUPABASE_S3_ACCESS_KEY_ID=your_supabase_s3_access_key_id
SUPABASE_S3_SECRET_ACCESS_KEY=your_supabase_s3_secret_access_key
SUPABASE_STORAGE_BUCKET=products
SUPABASE_STORAGE_PUBLIC_URL=https://cyakqxtjwyettzyzysok.supabase.co/storage/v1/object/public

# App
PORT=3000
NODE_ENV=development
